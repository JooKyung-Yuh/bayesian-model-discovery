# Copy this file to .env and fill in the key(s) you use. Never commit .env and never print its contents.
# The engine reads keys only from environment variables; the run scripts load this file in their own
# process and pass the key through without displaying it.

# Anthropic API key (the provider used for the paper runs)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (optional; only for --proposer openai / openai_compat)
OPENAI_API_KEY=sk-...
