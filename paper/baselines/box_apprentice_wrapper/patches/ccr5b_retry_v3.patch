+    if critic_mode and (not critic_info_all or len(critic_info_all[-1]) == 0):
+        if critic_info_all: critic_info_all[-1] = [{"str_hypotheses": "", "synthesis": "", "ccr5b_placeholder": True}]
+
+
+CCR5B_MAX_RETRIES = 2
+CCR5B_LOG = "ccr5b_retries.json"
